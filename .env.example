# =============================================================================
# RailFlow Optimizer — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local          (Linux / macOS)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#
# NEVER commit .env or .env.local to version control.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# AI Provider — pick ONE block and fill it in
# -----------------------------------------------------------------------------

# --- Option A: Google Gemini (via Google AI Studio) -------------------------
# Get your key at https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# --- Option B: OpenAI --------------------------------------------------------
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# --- Option C: OpenAI-compatible providers -----------------------------------
# Works with Groq, Mistral, Together AI, Fireworks, Anyscale, etc.
# Set the base URL to your provider's OpenAI-compatible endpoint.
# OPENAI_API_KEY=your_provider_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # example: Groq
# OPENAI_BASE_URL=https://api.mistral.ai/v1         # example: Mistral

# --- Option D: Anthropic (Claude) --------------------------------------------
# Get your key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Option E: Local / self-hosted (Ollama, LM Studio, etc.) ----------------
# No API key needed for local models.
# OPENAI_BASE_URL=http://localhost:11434/v1         # example: Ollama
# OPENAI_API_KEY=ollama                             # placeholder (required by some SDKs)


# -----------------------------------------------------------------------------
# Firebase (optional — only needed if you enable Firestore / Auth backend)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
